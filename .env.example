# Sem chave:
WEB_ENABLED=true
TRIADE_PROVIDER_MAX_TOKENS=16000
WEB_SEARCH_PROVIDER=bing_rss
WEB_SEARCH_URL=https://www.bing.com/search
WEB_QUERY_EXPANSION_ENABLED=true
WEB_MAX_QUERY_VARIANTS=4
WEB_CROSS_LANGUAGE_SEARCH=true
WEB_DEFAULT_REGION=BR
WEB_MIN_RESULT_RELEVANCE=0.55
WEB_MIN_SOURCE_RELEVANCE=0.65
WEB_RELEVANCE_TOP_K=8
WEB_MAX_RESEARCH_CORRECTIONS=2
WEB_MAX_TOTAL_SEARCHES=6
WEB_MAX_TOTAL_OPENS=10
ACTION_CONFIRMATION_TIMEOUT_SECONDS=300
CODEX_QUICK_WAIT_TIMEOUT_SECONDS=60
CODEX_TURN_HARD_TIMEOUT_SECONDS=0
CODEX_JOB_RETENTION_DAYS=7
AGENT_DECISION_SHADOW=false
AGENT_DECISION_FAST_PATH=true
AGENT_DECISION_CONTEXT_CACHE=true

# Phase 1.75B: shadow permanece o rollback imediato. bounded_live conecta cada
# NextAction ao validator, ExecutionAuthority e executor real.
ORCHESTRATION_MODE=shadow
ORCHESTRATION_SHADOW_ENABLED=false
ORCHESTRATION_FAST_PATH_ENABLED=true
ORCHESTRATION_DECISION_CACHE_ENABLED=true
ORCHESTRATION_DECISION_CACHE_MAX_ENTRIES=128
ORCHESTRATION_SHADOW_MAX_STEPS=8
ORCHESTRATION_SHADOW_MAX_OBSERVATIONS=16
ORCHESTRATION_SHADOW_MAX_ACTION_HISTORY=16
ORCHESTRATION_SHADOW_MAX_CONTEXT_ITEMS=64
ORCHESTRATION_SHADOW_MAX_REPEATED_ACTION=2
ORCHESTRATION_SHADOW_MAX_SAME_OBSERVATION=2
ORCHESTRATION_SHADOW_MAX_FAILURES=3
ORCHESTRATION_MAX_MODEL_CALLS=8
ORCHESTRATION_MAX_TOOL_CALLS=8
ORCHESTRATION_MAX_DELEGATIONS=4
ORCHESTRATION_MAX_ELAPSED_SECONDS=900

# DeepSeek consultivo (API stateless; sessao persistida localmente).
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_AUTO_ESCALATION=false
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=180
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_SESSION_MAX_RECENT_TURNS=20

# Alternativa Brave Search API:
# WEB_SEARCH_PROVIDER=brave
# WEB_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
# WEB_SEARCH_API_KEY=adicione_sua_chave

