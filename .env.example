VOICE_STT_COMPUTE_TYPE=int8
VOICE_STT_LANGUAGE=pt
VOICE_STT_THREADS=4
VOICE_STT_TIMEOUT_SECONDS=120
VOICE_TTS_PROVIDER=windows_sapi
VOICE_MODE=windows_sapi
